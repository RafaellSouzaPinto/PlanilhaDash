# Banco de dados (MariaDB 10.11)
DATABASE_URL=mysql://user:password@localhost:3306/planilhadash

# Chave de criptografia AES-256-GCM (32 bytes = 64 chars hex)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# Segredo da sessão Lucia Auth
# Gerar: openssl rand -base64 32
LUCIA_SECRET=your_random_session_secret_here

# URL pública da aplicação (opcional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Limites configuráveis
MAX_FILE_SIZE_MB=10
AI_SAMPLE_ROWS=50
FREE_TIER_LIMIT=3

# Chave de IA server-side para o free tier (Tier 0)
# Usada quando o usuário não tem chave própria e ainda tem análises gratuitas disponíveis.
# Usar modelo econômico (ex: GPT-4o mini) para manter custo baixo (~$0,001/análise).
# Se não definida, usuários sem chave própria não têm acesso à IA.
# NUNCA exposta ao cliente — usada apenas em rotas server-side.
PLANILHA_OPENAI_KEY=
